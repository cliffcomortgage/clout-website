---
import { SITE, PRODUCTS, STATES } from '../data/site';

const year = new Date().getFullYear();
const topProducts = PRODUCTS.filter((p) => p.tier <= 2);
---

<footer class="site-footer">
  <div class="spark-tile" aria-hidden="true"></div>

  <div class="footer-inner">

    <div class="footer-top">
      <div class="footer-brand">
        <img src="/brand/logo-mono-white.svg" alt={`${SITE.name} logo`} height="36" />
        <p class="footer-tagline">Your pipeline, accelerated.</p>
        <p class="footer-contact">
          <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
        <address class="footer-address">
          {SITE.hq.streetAddress}<br />
          {SITE.hq.addressLocality}, {SITE.hq.addressRegion} {SITE.hq.postalCode}
        </address>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <p class="footer-col-label">Loan options</p>
          <ul>
            {topProducts.map((p) => (
              <li><a href={`/loan-options/${p.slug}/`}>{p.shortName}</a></li>
            ))}
            <li><a href="/loan-options/">All programs</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col-label">Locations</p>
          <ul>
            {STATES.map((s) => (
              <li><a href={`/locations/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col-label">Company</p>
          <ul>
            <li><a href="/about/">About Clout</a></li>
            <li><a href="/about/leadership/">Leadership</a></li>
            <li><a href="/brokers/">Broker partners</a></li>
            <li><a href="/investors/">Real estate investors</a></li>
            <li><a href="/resources/">Resources</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col-label">Partner Portal</p>
          <ul>
            <li><a href="/tpo-connect/">TPO Connect</a></li>
            <li><a href="/powered-up-pricing/">Powered Up Pricing</a></li>
            <li><a href="/tpo-connect/#apply">Become a partner</a></li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="footer-hr" />

    <div class="compliance-block">
      <p>
        <strong>{SITE.legalName}</strong> · NMLS #{SITE.nmlsId} ·
        <a href={SITE.nmlsUrl} target="_blank" rel="noopener">NMLS Consumer Access</a>
        ·
        <a href="/compliance/licensing/">State Licensing</a>
        ·
        <a href="/compliance/privacy/">Privacy Policy</a>
        ·
        <a href="/compliance/accessibility/">Accessibility</a>
        ·
        <a href="/compliance/tcpa/">TCPA</a>
        ·
        <a href="/compliance/fair-lending/">Fair Lending</a>
      </p>
      <p>Equal Housing Lender · Licensed in {STATES.map((s) => s.abbr).join(' · ')}</p>
      <p>
        Clout is the wholesale and direct-to-investor channel of
        {' '}<a href={SITE.parentOrg.url} target="_blank" rel="noopener">{SITE.parentOrg.name}</a>.
      </p>
      <p class="footer-copy">© {year} {SITE.legalName}. All rights reserved.</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-brand-deep);
    color: var(--color-paper);
    position: relative;
    overflow: hidden;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 2rem 2.5rem;
    position: relative;
    z-index: 1;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 2.5fr;
    gap: 4rem;
    margin-bottom: 3.5rem;
  }

  .footer-brand img {
    height: 34px;
    width: auto;
    display: block;
    margin-bottom: 1.25rem;
  }
  .footer-tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 1.25rem;
    letter-spacing: -0.01em;
  }
  .footer-contact {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-contact a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .footer-contact a:hover { color: var(--color-brand-bright); }
  .footer-contact span { color: rgba(255, 255, 255, 0.25); }

  .footer-address {
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .footer-col-label {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brand-warmth);
    margin: 0 0 1rem;
    display: block;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .footer-col a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 120ms ease;
  }
  .footer-col a:hover { color: var(--color-paper); }

  .footer-hr {
    border: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 0 2rem;
  }

  .compliance-block {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.38);
  }
  .compliance-block p { margin: 0 0 0.5rem; }
  .compliance-block a {
    color: rgba(255, 255, 255, 0.58);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.14);
    transition: color 120ms ease;
  }
  .compliance-block a:hover { color: var(--color-brand-bright); }
  .footer-copy {
    margin-top: 1.25rem !important;
    color: rgba(255, 255, 255, 0.22);
  }

  @media (max-width: 1024px) {
    .footer-top { grid-template-columns: 1fr; gap: 2.5rem; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }
  @media (max-width: 560px) {
    .footer-cols { grid-template-columns: 1fr; }
    .footer-inner { padding: 3.5rem 1.25rem 2rem; }
  }
</style>
