---
import { SITE, PRODUCTS, STATES } from '../data/site';
---

<header class="site-header">
  <div class="header-row">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <img src="/brand/logo-mono-white.svg" alt={`${SITE.name} logo`} width="192" height="54" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        <li class="has-menu">
          <button type="button" aria-haspopup="true" aria-expanded="false">Loan Options</button>
          <div class="menu-panel">
            <div class="menu-grid">
              {PRODUCTS.map((p) => (
                <a href={`/loan-options/${p.slug}/`} class="menu-item">
                  <span class="menu-name">{p.shortName}</span>
                  <span class="menu-desc">{p.shortDescription}</span>
                </a>
              ))}
            </div>
            <div class="menu-foot">
              <a href="/loan-options/">All loan programs →</a>
            </div>
          </div>
        </li>
        <li class="has-menu">
          <button type="button" aria-haspopup="true" aria-expanded="false">Locations</button>
          <div class="menu-panel">
            <div class="menu-grid menu-grid-states">
              {STATES.map((s) => (
                <a href={`/locations/${s.slug}/`} class="menu-item">
                  <span class="menu-name">{s.name}</span>
                  <span class="menu-desc">
                    {s.topMetros.slice(0, 3).join(' · ')}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </li>
        <li><a href="/brokers/">Brokers</a></li>
        <li><a href="/investors/">Investors</a></li>
        <li><a href="/resources/">Resources</a></li>
        <li class="has-menu">
          <button type="button" aria-haspopup="true" aria-expanded="false" class="nav-portal-trigger">Partner Portal</button>
          <div class="menu-panel menu-panel-portal">
            <div class="menu-grid menu-grid-portal">
              <a href="/tpo-connect/" class="menu-item">
                <span class="menu-name">TPO Connect</span>
                <span class="menu-desc">Wholesale partner portal: register, submit files, track pipeline, and access scenario desk.</span>
              </a>
              <a href="/powered-up-pricing/" class="menu-item">
                <span class="menu-name">Powered Up Pricing</span>
                <span class="menu-desc">Scenario pricing engine for multi-program quotes across FICO and LTV bands. Powered by LoanNEX.</span>
              </a>
            </div>
            <div class="menu-foot">
              <a href="/tpo-connect/#apply">Apply to become a partner →</a>
            </div>
          </div>
        </li>
      </ul>
    </nav>

    <div class="header-cta">
      <a href={`tel:${SITE.phone}`} class="phone-link">{SITE.phoneDisplay}</a>
      <a href="/contact/" class="header-btn">Get pre-qualified</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-brand-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-row {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.875rem 2rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand img {
    display: block;
    height: 19px;
    width: auto;
  }

  .primary-nav { font-size: 0.9375rem; }
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .primary-nav a,
  .primary-nav button {
    display: inline-block;
    padding: 0.5rem 0.875rem;
    color: rgba(255, 255, 255, 0.72);
    background: transparent;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color 120ms ease, background 120ms ease;
    white-space: nowrap;
  }
  .primary-nav a:hover,
  .primary-nav button:hover {
    color: var(--color-paper);
    background: rgba(255, 255, 255, 0.08);
    text-decoration: none;
  }

  .has-menu { position: relative; }
  .menu-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    /* A definite width (not min-width) so the grid distributes it and text
       wraps predictably. An auto-width absolutely-positioned panel sizes
       toward each grid column's max-content (text refuses to wrap) —
       that's what was pushing panels past the viewport edge and causing
       page-wide horizontal scroll. */
    width: 640px;
    max-width: calc(100vw - 2rem);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    box-shadow:
      0 20px 60px -16px rgba(0, 0, 0, 0.22),
      0 4px 16px -4px rgba(0, 0, 0, 0.1);
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms ease;
  }
  .has-menu:hover .menu-panel,
  .has-menu:focus-within .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 0.75rem;
  }
  .menu-grid-states { grid-template-columns: repeat(3, 1fr); }

  .menu-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 100ms ease;
  }
  /* .menu-item is an <a> nested inside .primary-nav, so "white-space: nowrap"
     from ".primary-nav a" (higher specificity — it has an extra element
     selector) wins over a plain ".menu-item" override. Without un-setting it
     here, dropdown descriptions refuse to wrap and spill across neighboring
     grid columns instead. */
  .menu-panel .menu-item {
    white-space: normal;
  }
  .menu-item:hover { background: var(--color-surface); }

  .menu-name {
    font-weight: 600;
    color: var(--color-ink);
    font-size: 0.9375rem;
  }
  .menu-desc {
    font-size: 0.8125rem;
    color: var(--color-mid);
    line-height: 1.4;
  }

  .menu-foot {
    border-top: 1px solid var(--color-line);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    text-align: right;
  }
  .menu-foot a {
    color: var(--color-brand-deep);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .menu-foot a:hover { text-decoration: underline; }

  .nav-portal-trigger {
    color: var(--color-brand-bright) !important;
    border: 1px solid rgba(3, 191, 181, 0.3) !important;
    margin-left: 0.25rem;
  }
  .nav-portal-trigger:hover,
  .has-menu:hover .nav-portal-trigger,
  .has-menu:focus-within .nav-portal-trigger {
    color: var(--color-brand-bright) !important;
    background: rgba(3, 191, 181, 0.1) !important;
    border-color: rgba(3, 191, 181, 0.5) !important;
  }
  .menu-panel-portal {
    left: auto;
    right: 0;
    width: 480px;
  }
  .menu-grid-portal { grid-template-columns: 1fr; }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }
  .phone-link {
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 120ms ease;
    white-space: nowrap;
  }
  .phone-link:hover { color: var(--color-paper); }

  .header-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-brand-bright);
    color: var(--color-ink);
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 120ms ease, color 120ms ease;
  }
  .header-btn:hover {
    background: color-mix(in srgb, var(--color-brand-bright) 80%, black);
    color: var(--color-paper);
  }

  @media (max-width: 1024px) {
    .primary-nav,
    .phone-link { display: none; }
    .header-row { grid-template-columns: auto 1fr; }
    .header-cta { justify-content: flex-end; }
  }
  @media (max-width: 480px) {
    .header-row { padding: 0.875rem 1.25rem; }
    .brand img { height: 32px; }
  }
</style>
