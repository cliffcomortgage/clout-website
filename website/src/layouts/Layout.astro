---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  organizationSchema,
  localBusinessSchema,
  breadcrumbSchema,
  jsonLd,
} from '../data/schema';
import { SITE } from '../data/site';

type Breadcrumb = { name: string; url: string };

interface Props {
  title: string;
  description: string;
  /** Will be rendered as <link rel="canonical" />. Should be absolute. */
  canonical?: string;
  /** Path segment for OG image; defaults to brand logo. */
  ogImage?: string;
  /** Breadcrumb trail starting at homepage. */
  breadcrumbs?: Breadcrumb[];
  /** Additional JSON-LD blocks (already stringified). */
  extraSchema?: string[];
  /** Optional noindex for search/utility pages. */
  noindex?: boolean;
  /** Porcelain-background footer instead of the default dark Deep Reserve footer. */
  footerLight?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/brand/logo-primary.svg',
  breadcrumbs,
  extraSchema = [],
  noindex = false,
  footerLight = false,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;

const schemaBlocks: string[] = [
  jsonLd(organizationSchema()),
  jsonLd(localBusinessSchema()),
  ...(breadcrumbs ? [jsonLd(breadcrumbSchema(breadcrumbs))] : []),
  ...extraSchema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#004045" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />

    {/* Open Graph + Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Icon */}
    <link rel="icon" type="image/svg+xml" href="/brand/icon-primary.svg" />

    {/* JSON-LD schema */}
    {schemaBlocks.map((block) => (
      <script type="application/ld+json" set:html={block} />
    ))}
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer light={footerLight} />
    <script>
      // Scroll progress bar — informational, not decorative, so it still
      // renders (just without the eased width transition) under
      // prefers-reduced-motion rather than being removed entirely.
      const bar = document.getElementById('scroll-progress');
      if (bar) {
        const update = () => {
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
          bar.style.width = pct + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      }

      // Fade-up reveals: opt in per-element with class="reveal-up".
      // Respects prefers-reduced-motion by just showing everything immediately.
      const revealEls = document.querySelectorAll('.reveal-up');
      if (revealEls.length) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>
