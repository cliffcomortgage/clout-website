---
import Layout from '../layouts/Layout.astro';
import { SITE, PRODUCTS, STATES } from '../data/site';
import { faqSchema, jsonLd } from '../data/schema';

const tier1Products = PRODUCTS.filter((p) => p.tier === 1);
const tier2Products = PRODUCTS.filter((p) => p.tier === 2);
const tier3Products = PRODUCTS.filter((p) => p.tier === 3);
const featuredProducts = [...tier1Products, ...tier2Products, ...tier3Products];

const faqs = [
  {
    question: 'What is a Non-QM mortgage?',
    answer:
      'A Non-QM (non-qualified mortgage) is a home loan that does not meet the strict CFPB Qualified Mortgage standards. Non-QM programs use alternative income documentation — bank statements, 1099s, asset depletion, or property cash flow — to qualify self-employed borrowers, real estate investors, and other non-traditional applicants.',
  },
  {
    question: 'Is Clout a wholesale lender or a direct-to-consumer lender?',
    answer:
      'Both. Clout operates a wholesale Non-QM channel for mortgage brokers and a direct-to-investor channel for real estate investors. Brokers can place files with Clout through our wholesale partner portal; investors can apply directly.',
  },
  {
    question: 'Which states is Clout licensed in?',
    answer:
      `Clout is licensed in ${STATES.map((s) => s.name).join(', ')} under NMLS #65328. We are not currently licensed for activity in other states.`,
  },
  {
    question: 'How fast can Clout close a Non-QM loan?',
    answer:
      'Typical Clout DSCR and Bank Statement closings run 15–25 days from approval to funding for clean files. Foreign national and Asset Qualifier programs can take longer due to documentation seasoning requirements.',
  },
  {
    question: 'What credit score do I need for a Clout Non-QM loan?',
    answer:
      'Most Clout Non-QM programs require a minimum 620 FICO. Some programs accept lower scores with stronger compensating factors (larger down payment, lower DSCR, reserves). Final eligibility is determined by underwriting.',
  },
  {
    question: 'How is Clout different from Cliffco Mortgage Bankers?',
    answer:
      'Clout is the wholesale and direct-to-investor channel of Cliffco Mortgage Bankers. Cliffco focuses on retail mortgage lending; Clout focuses on Non-QM programs delivered through mortgage broker partners and directly to real estate investors. Both share NMLS #65328 and Cliffco\'s three decades of Non-QM expertise.',
  },
];
---

<Layout
  title={`${SITE.name} — Wholesale Non-QM lender for brokers and real estate investors`}
  description="Clout is a wholesale Non-QM mortgage lender and direct-to-investor lender licensed in 16 states and D.C. DSCR, bank statement, 1099, foreign national, and asset qualifier loans built for brokers and investors. NMLS #65328."
  extraSchema={[jsonLd(faqSchema(faqs))]}
  footerLight
>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Wholesale Non-QM · Direct-to-Investor</p>
        <h1 class="hero-title">
          Your pipeline,
          <span class="hero-accent">accelerated.</span>
        </h1>
        <p class="hero-lead">
          Clout funds Non-QM mortgages across 16 states and D.C. — DSCR, bank
          statement, 1099, foreign national, and asset qualifier programs. Wholesale
          channel for brokers. Direct channel for real estate investors.
          <strong>NMLS #65328.</strong>
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="cta-signal">Get pre-qualified</a>
          <a href="/brokers/" class="cta-ghost">Become a broker partner</a>
        </div>
        <dl class="hero-proof">
          <div>
            <dt>15–25 days</dt>
            <dd>Average close</dd>
          </div>
          <div>
            <dt>10</dt>
            <dd>Non-QM programs</dd>
          </div>
          <div>
            <dt>{STATES.length}</dt>
            <dd>States licensed + D.C.</dd>
          </div>
          <div>
            <dt>24–72h</dt>
            <dd>Initial decision</dd>
          </div>
        </dl>
      </div>

      <!-- Decorative only — the milestones/turn-times it dramatizes are already
           stated as real text above (hero-proof) and throughout the page. -->
      <div class="hero-visual" aria-hidden="true">
        <div class="pipeline">
          <div class="pipeline-line"></div>
          <ul class="pipeline-nodes">
            <li class="pipeline-node pipeline-node-1">
              <span class="node-ring"></span><span class="node-dot"></span>
              <span class="node-label">Submit</span>
            </li>
            <li class="pipeline-node pipeline-node-2">
              <span class="node-ring"></span><span class="node-dot"></span>
              <span class="node-label">Scenario</span>
            </li>
            <li class="pipeline-node pipeline-node-3">
              <span class="node-ring"></span><span class="node-dot"></span>
              <span class="node-label">Conditions</span>
            </li>
            <li class="pipeline-node pipeline-node-4">
              <span class="node-ring"></span><span class="node-dot"></span>
              <span class="node-label">CTC</span>
            </li>
            <li class="pipeline-node pipeline-node-5">
              <span class="node-ring"></span><span class="node-dot"></span>
              <span class="node-check">✓</span>
              <span class="node-label">Funded</span>
              <span class="burst-dot burst-dot-1"></span>
              <span class="burst-dot burst-dot-2"></span>
              <span class="burst-dot burst-dot-3"></span>
              <span class="burst-dot burst-dot-4"></span>
            </li>
          </ul>
          <div class="pipeline-card">
            <span class="card-trail"></span>
            <span class="card-body">
              <span class="card-fold"></span>
              <span class="card-line"></span>
              <span class="card-line short"></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PRECISION STRIP ══════════════════════════════════ -->
  <section class="precision-strip" aria-label="At a glance">
    <div class="wrap">
      <ul class="strip-list">
        <li>
          <span class="strip-label">Products</span>
          <span class="strip-value">10 Non-QM programs</span>
        </li>
        <li>
          <span class="strip-label">Licensed</span>
          <span class="strip-value">16 states + D.C.</span>
        </li>
        <li>
          <span class="strip-label">Channels</span>
          <span class="strip-value">Wholesale brokers · Direct investors</span>
        </li>
        <li>
          <span class="strip-label">NMLS</span>
          <span class="strip-value">#{SITE.nmlsId}</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══ PROGRAMS ════════════════════════════════════════ -->
  <section class="programs-section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Loan programs</p>
        <h2>The programs your deals <span class="jitzu">need.</span></h2>
        <p class="section-subhead">
          Ten Non-QM programs covering income documentation of every kind —
          from DSCR and bank statements to 1099s, assets, and foreign national profiles.
        </p>
      </header>
      <div class="programs-grid">
        {featuredProducts.map((p) => (
          <a href={`/loan-options/${p.slug}/`} class="program-card">
            <span class="program-tier">Tier {p.tier}</span>
            <h3>{p.shortName}</h3>
            <p>{p.shortDescription}</p>
            <span class="program-link">Explore {p.shortName} →</span>
          </a>
        ))}
      </div>
      <p class="tier4-note">
        Plus three additional programs for narrow use cases:
        {PRODUCTS.filter((p) => p.tier === 4).map((p, i, arr) => (
          <>
            <a href={`/loan-options/${p.slug}/`}>{p.shortName}</a>{i < arr.length - 1 && ', '}
          </>
        ))}.
      </p>
    </div>
  </section>

  <!-- ═══ CHANNELS ═══════════════════════════════════════ -->
  <section class="channels-section">
    <div class="wrap channels-inner">
      <header class="channels-head">
        <p class="ch-eyebrow">Two channels</p>
        <h2 class="channels-title">
          Built for brokers.<br />
          <span class="jitzu">Built for investors.</span>
        </h2>
      </header>
      <div class="channels-grid">
        <a href="/brokers/" class="channel-card">
          <p class="channel-eyebrow">Mortgage brokers</p>
          <h3>Wholesale Non-QM</h3>
          <p>
            Place Non-QM files with a wholesale lender that closes in 15–25 days,
            publishes program guides openly, and pays compensation on your terms.
            Full pipeline access through TPO Connect.
          </p>
          <span class="channel-link">Broker partner channel →</span>
        </a>
        <a href="/investors/" class="channel-card">
          <p class="channel-eyebrow">Real estate investors</p>
          <h3>Direct-to-Investor</h3>
          <p>
            Qualify on property cash flow, business income, or assets — not W-2s.
            DSCR, bank statement, and foreign national programs built for portfolio
            builders and fix-and-flip investors.
          </p>
          <span class="channel-link">Investor channel →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ LOCATIONS ══════════════════════════════════════ -->
  <section class="locations-section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Coverage</p>
        <h2>{STATES.length} states. <span class="jitzu">Local depth.</span></h2>
        <p class="section-subhead">
          Active Non-QM lending across a 16-state and D.C. footprint —
          with local market knowledge in each territory.
        </p>
      </header>
      <div class="states-grid">
        {STATES.map((s) => (
          <a href={`/locations/${s.slug}/`} class="state-card">
            <p class="state-abbr">{s.abbr}</p>
            <h3>{s.name}</h3>
            <p class="state-metros">{s.topMetros.join(' · ')}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ════════════════════════════════════════════ -->
  <section class="faq-section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Common questions</p>
        <h2>What people ask about <span class="jitzu">Clout.</span></h2>
      </header>
      <div class="faq" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map((f) => (
          <details itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <summary itemprop="name">{f.question}</summary>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p itemprop="text">{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Shared layout ──────────────────── */
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Jitzu display accent — used mid-headline for brand emphasis */
  .jitzu {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Section eyebrow — page-level (complements global .eyebrow) */
  .eyebrow {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-warmth);
    margin: 0 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  .section-head {
    margin: 0 0 3rem;
    max-width: 52ch;
  }
  .section-head h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 1rem;
    letter-spacing: -0.015em;
  }
  .section-subhead {
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
    margin: 0;
    max-width: 56ch;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .hero {
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 8rem 0 6rem;
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-eyebrow {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-warmth);
    margin: 0 0 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.0;
    color: var(--color-ink);
    margin: 0 0 2rem;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  .hero-accent {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-brand-bright);
    display: block;
  }

  .hero-lead {
    max-width: 54ch;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0 0 2.5rem;
  }
  .hero-lead strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 4.5rem;
  }
  /* .cta-ghost is designed for dark Deep Reserve backgrounds (white outline) —
     override for the hero's porcelain background. */
  .hero-actions .cta-ghost {
    color: var(--color-brand-deep);
    border-color: color-mix(in srgb, var(--color-brand-deep) 35%, transparent);
  }
  .hero-actions .cta-ghost:hover {
    border-color: var(--color-brand-deep);
    background: color-mix(in srgb, var(--color-brand-deep) 8%, transparent);
    color: var(--color-brand-deep);
  }

  .hero-proof {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    gap: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    margin: 0;
  }
  .hero-proof div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hero-proof dt {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-proof dd {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin: 0;
  }

  @media (max-width: 720px) {
    .hero { padding: 5rem 0 4rem; }
    .hero-proof {
      grid-template-columns: repeat(2, max-content);
      gap: 1.5rem 3rem;
    }
  }
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
  }

  /* ══════════════════════════════════════
     HERO VISUAL — "Pipeline Milestones"
     A file card travels a horizontal track, lighting up each checkpoint as
     it passes and ending in a checkmark burst on "Funded" before looping.
     Pure CSS (no JS/video) — card position and each node's pulse share one
     animation-duration so they stay phase-locked across every loop.
     ══════════════════════════════════════ */
  .hero-visual {
    position: relative;
  }
  .pipeline {
    position: relative;
    height: 168px;
  }
  .pipeline-line {
    position: absolute;
    top: 23px;
    left: 5px;
    right: 5px;
    height: 2px;
    background: var(--color-line);
    z-index: 1;
  }
  .pipeline-nodes {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pipeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    width: 3rem;
    flex-shrink: 0;
  }
  .node-ring {
    position: absolute;
    top: 18px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-brand-bright);
    opacity: 0;
    pointer-events: none;
  }
  .node-dot {
    position: relative;
    z-index: 2;
    width: 10px;
    height: 10px;
    margin-top: 18px;
    border-radius: 50%;
    background: var(--color-paper);
    border: 2px solid var(--color-line);
  }
  .node-label {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-mid);
    white-space: nowrap;
  }
  .pipeline-node-5 { position: relative; }
  .node-check {
    position: absolute;
    top: 12px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-brand-bright);
    color: var(--color-paper);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
    opacity: 0;
    z-index: 3;
  }
  .burst-dot {
    position: absolute;
    top: 22px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--color-brand-warmth);
    opacity: 0;
  }

  .pipeline-card {
    position: absolute;
    top: 6px;
    left: -6%;
    width: 32px;
    height: 26px;
    z-index: 4;
    opacity: 0;
    animation: card-travel 7s linear infinite;
  }
  .card-trail {
    position: absolute;
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 3px;
    background: linear-gradient(to left, color-mix(in srgb, var(--color-brand-bright) 65%, transparent), transparent);
    filter: blur(1px);
  }
  .card-body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-paper);
    border: 1.5px solid var(--color-brand-deep);
    border-radius: 5px;
    box-shadow: 0 4px 10px -3px color-mix(in srgb, var(--color-brand-deep) 40%, transparent);
    animation: card-bob 1.1s ease-in-out infinite;
  }
  .card-fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 8px;
    height: 8px;
    background: var(--color-surface);
    border-left: 1.5px solid var(--color-brand-deep);
    border-bottom: 1.5px solid var(--color-brand-deep);
    border-bottom-left-radius: 3px;
  }
  .card-line {
    position: absolute;
    left: 5px;
    right: 9px;
    top: 10px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-line);
  }
  .card-line.short {
    top: 16px;
    right: 15px;
  }

  @keyframes card-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  /* Card position/opacity as % of the 7s loop — arrives at each of the 5
     nodes (0%, 25%, 50%, 75%, 100% across the track) at 6%, 28%, 50%, 72%,
     90% of the timeline, then holds, fades, and resets before looping. */
  @keyframes card-travel {
    0%   { left: -6%; opacity: 0; }
    4%   { opacity: 1; }
    6%   { left: 0%; }
    28%  { left: 25%; }
    50%  { left: 50%; }
    72%  { left: 75%; }
    90%  { left: 94%; opacity: 1; }
    97%  { left: 94%; opacity: 0; }
    100% { left: -6%; opacity: 0; }
  }

  /* Each node's pulse fires once per loop, timed to the card's arrival
     above — the node holds its "idle" look (base CSS) until its delay
     elapses, pulses briefly, then stays "completed" for the rest of the
     loop until the next lap resets it. */
  .pipeline-node-1 .node-dot, .pipeline-node-1 .node-ring { animation-delay: 0.28s; }
  .pipeline-node-2 .node-dot, .pipeline-node-2 .node-ring { animation-delay: 1.96s; }
  .pipeline-node-3 .node-dot, .pipeline-node-3 .node-ring { animation-delay: 3.5s; }
  .pipeline-node-4 .node-dot, .pipeline-node-4 .node-ring { animation-delay: 5.04s; }
  .pipeline-node-5 .node-dot, .pipeline-node-5 .node-ring,
  .pipeline-node-5 .node-check, .pipeline-node-5 .burst-dot { animation-delay: 6.3s; }

  .node-dot {
    animation: node-fill 7s linear infinite;
  }
  .node-ring {
    animation: node-ring-ping 7s linear infinite;
  }
  @keyframes node-fill {
    0%   { transform: scale(1); background: var(--color-paper); border-color: var(--color-line); }
    3%   { transform: scale(1.4); background: var(--color-brand-bright); border-color: var(--color-brand-bright); }
    12%  { transform: scale(1); background: var(--color-brand-bright); border-color: var(--color-brand-bright); }
    100% { background: var(--color-brand-bright); border-color: var(--color-brand-bright); }
  }
  @keyframes node-ring-ping {
    0%   { transform: scale(0.6); opacity: 0; }
    2%   { transform: scale(0.6); opacity: 0.5; }
    16%  { transform: scale(2); opacity: 0; }
    100% { opacity: 0; }
  }
  .pipeline-node .node-label { transition: none; }
  .pipeline-node-1 .node-label, .pipeline-node-2 .node-label,
  .pipeline-node-3 .node-label, .pipeline-node-4 .node-label,
  .pipeline-node-5 .node-label {
    animation: node-label-fill 7s linear infinite;
  }
  .pipeline-node-1 .node-label { animation-delay: 0.28s; }
  .pipeline-node-2 .node-label { animation-delay: 1.96s; }
  .pipeline-node-3 .node-label { animation-delay: 3.5s; }
  .pipeline-node-4 .node-label { animation-delay: 5.04s; }
  .pipeline-node-5 .node-label { animation-delay: 6.3s; }
  @keyframes node-label-fill {
    0%   { color: var(--color-mid); }
    12%  { color: var(--color-brand-deep); }
    100% { color: var(--color-brand-deep); }
  }

  .node-check {
    animation: check-pop 7s linear infinite;
  }
  @keyframes check-pop {
    0%   { opacity: 0; transform: scale(0.4) rotate(-10deg); }
    3%   { opacity: 1; transform: scale(1.2) rotate(0deg); }
    8%   { transform: scale(1) rotate(0deg); }
    92%  { opacity: 1; }
    97%  { opacity: 0; }
    100% { opacity: 0; }
  }

  .burst-dot { animation: burst-fly 7s linear infinite; }
  .burst-dot-1 { --a: -55deg; }
  .burst-dot-2 { --a: -18deg; }
  .burst-dot-3 { --a: 18deg; }
  .burst-dot-4 { --a: 55deg; }
  @keyframes burst-fly {
