---
import Layout from '../layouts/Layout.astro';
import { SITE, PRODUCTS, STATES } from '../data/site';
import { faqSchema, jsonLd } from '../data/schema';

const tier1Products = PRODUCTS.filter((p) => p.tier === 1);
const tier2Products = PRODUCTS.filter((p) => p.tier === 2);
const tier3Products = PRODUCTS.filter((p) => p.tier === 3);
const featuredProducts = [...tier1Products, ...tier2Products, ...tier3Products];

const faqs = [
  {
    question: 'What is a Non-QM mortgage?',
    answer:
      'A Non-QM (non-qualified mortgage) is a home loan that does not meet the strict CFPB Qualified Mortgage standards. Non-QM programs use alternative income documentation — bank statements, 1099s, asset depletion, or property cash flow — to qualify self-employed borrowers, real estate investors, and other non-traditional applicants.',
  },
  {
    question: 'Is Clout a wholesale lender or a direct-to-consumer lender?',
    answer:
      'Both. Clout operates a wholesale Non-QM channel for mortgage brokers and a direct-to-investor channel for real estate investors. Brokers can place files with Clout through our wholesale partner portal; investors can apply directly.',
  },
  {
    question: 'Which states is Clout licensed in?',
    answer:
      `Clout is licensed in ${STATES.map((s) => s.name).join(', ')} under NMLS #65328. We are not currently licensed for activity in other states.`,
  },
  {
    question: 'How fast can Clout close a Non-QM loan?',
    answer:
      'Typical Clout DSCR and Bank Statement closings run 15–25 days from approval to funding for clean files. Foreign national and Asset Qualifier programs can take longer due to documentation seasoning requirements.',
  },
  {
    question: 'What credit score do I need for a Clout Non-QM loan?',
    answer:
      'Most Clout Non-QM programs require a minimum 620 FICO. Some programs accept lower scores with stronger compensating factors (larger down payment, lower DSCR, reserves). Final eligibility is determined by underwriting.',
  },
  {
    question: 'How is Clout different from Cliffco Mortgage Bankers?',
    answer:
      'Clout is the wholesale and direct-to-investor channel of Cliffco Mortgage Bankers. Cliffco focuses on retail mortgage lending; Clout focuses on Non-QM programs delivered through mortgage broker partners and directly to real estate investors. Both share NMLS #65328 and Cliffco\'s three decades of Non-QM expertise.',
  },
];
---

<Layout
  title={`${SITE.name} — Wholesale Non-QM lender for brokers and real estate investors`}
  description="Clout is a wholesale Non-QM mortgage lender and direct-to-investor lender licensed in 16 states and D.C. DSCR, bank statement, 1099, foreign national, and asset qualifier loans built for brokers and investors. NMLS #65328."
  extraSchema={[jsonLd(faqSchema(faqs))]}
  footerLight
>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="hero-eyebrow">Wholesale Non-QM · Direct-to-Investor</p>
      <h1 class="hero-title">
        Your pipeline,
        <span class="hero-accent">accelerated.</span>
      </h1>
      <p class="hero-lead">
        Clout funds Non-QM mortgages across 16 states and D.C. — DSCR, bank
        statement, 1099, foreign national, and asset qualifier programs. Wholesale
        channel for brokers. Direct channel for real estate investors.
        <strong>NMLS #65328.</strong>
      </p>
      <div class="hero-actions">
        <a href="/contact/" class="cta-signal">Get pre-qualified</a>
        <a href="/brokers/" class="cta-ghost">Become a broker partner</a>
      </div>
      <dl class="hero-proof">
        <div>
          <dt>15–25 days</dt>
          <dd>Average close</dd>
        </div>
        <div>
          <dt>10</dt>
          <dd>Non-QM programs</dd>
        </div>
        <div>
          <dt>{STATES.length}</dt>
          <dd>States licensed + D.C.</dd>
        </div>
        <div>
          <dt>24–72h</dt>
          <dd>Initial decision</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ═══ PRECISION STRIP ══════════════════════════════════ -->
  <section class="precision-strip" aria-label="At a glance">
    <div class="wrap">
      <ul class="strip-list">
        <li>
          <span class="strip-label">Products</span>
          <span class="strip-value">10 Non-QM programs</span>
        </li>
        <li>
          <span class="strip-label">Licensed</span>
          <span class="strip-value">16 states + D.C.</span>
        </li>
        <li>
          <span class="strip-label">Channels</span>
          <span class="strip-value">Wholesale brokers · Direct investors</span>
        </li>
        <li>
          <span class="strip-label">NMLS</span>
          <span class="strip-value">#{SITE.nmlsId}</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══ PROGRAMS ════════════════════════════════════════ -->
  <section class="programs-section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Loan programs</p>
        <h2>The programs your deals <span class="jitzu">need.</span></h2>
        <p class="section-subhead">
          Ten Non-QM programs covering income documentation of every kind —
          from DSCR and bank statements to 1099s, assets, and foreign national profiles.
        </p>
      </header>
      <div class="programs-grid">
        {featuredProducts.map((p) => (
          <a href={`/loan-options/${p.slug}/`} class="program-card">
            <span class="program-tier">Tier {p.tier}</span>
            <h3>{p.shortName}</h3>
            <p>{p.shortDescription}</p>
            <span class="program-link">Explore {p.shortName} →</span>
          </a>
        ))}
      </div>
      <p class="tier4-note">
        Plus three additional programs for narrow use cases:
        {PRODUCTS.filter((p) => p.tier === 4).map((p, i, arr) => (
          <>
            <a href={`/loan-options/${p.slug}/`}>{p.shortName}</a>{i < arr.length - 1 && ', '}
          </>
        ))}.
      </p>
    </div>
  </section>

  <!-- ═══ CHANNELS ═══════════════════════════════════════ -->
  <section class="channels-section">
    <div class="wrap channels-inner">
      <header class="channels-head">
        <p class="ch-eyebrow">Two channels</p>
        <h2 class="channels-title">
          Built for brokers.<br />
          <span class="jitzu">Built for investors.</span>
        </h2>
      </header>
      <div class="channels-grid">
        <a href="/brokers/" class="channel-card">
          <p class="channel-eyebrow">Mortgage brokers</p>
          <h3>Wholesale Non-QM</h3>
          <p>
            Place Non-QM files with a wholesale lender that closes in 15–25 days,
            publishes program guides openly, and pays compensation on your terms.
            Full pipeline access through TPO Connect.
          </p>
          <span class="channel-link">Broker partner channel →</span>
        </a>
        <a href="/investors/" class="channel-card">
          <p class="channel-eyebrow">Real estate investors</p>
          <h3>Direct-to-Investor</h3>
          <p>
            Qualify on property cash flow, business income, or assets — not W-2s.
            DSCR, bank statement, and foreign national programs built for portfolio
            builders and fix-and-flip investors.
          </p>
          <span class="channel-link">Investor channel →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ LOCATIONS ══════════════════════════════════════ -->
  <section class="locations-section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Coverage</p>
        <h2>{STATES.length} states. <span class="jitzu">Local depth.</span></h2>
        <p class="section-subhead">
          Active Non-QM lending across a 16-state and D.C. footprint —
          with local market knowledge in each territory.
        </p>
      </header>
      <div class="states-grid">
        {STATES.map((s) => (
          <a href={`/locations/${s.slug}/`} class="state-card">
            <p class="state-abbr">{s.abbr}</p>
            <h3>{s.name}</h3>
            <p class="state-metros">{s.topMetros.join(' · ')}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ════════════════════════════════════════════ -->
  <section class="faq-section">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Common questions</p>
        <h2>What people ask about <span class="jitzu">Clout.</span></h2>
      </header>
      <div class="faq" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map((f) => (
          <details itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <summary itemprop="name">{f.question}</summary>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p itemprop="text">{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Shared layout ──────────────────── */
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Jitzu display accent — used mid-headline for brand emphasis */
  .jitzu {
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* Section eyebrow — page-level (complements global .eyebrow) */
  .eyebrow {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-warmth);
    margin: 0 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  .section-head {
    margin: 0 0 3rem;
    max-width: 52ch;
  }
  .section-head h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 1rem;
    letter-spacing: -0.015em;
  }
  .section-subhead {
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
    margin: 0;
    max-width: 56ch;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .hero {
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 8rem 0 6rem;
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-warmth);
    margin: 0 0 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.0;
    color: var(--color-ink);
    margin: 0 0 2rem;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  .hero-accent {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-brand-bright);
    display: block;
  }

  .hero-lead {
    max-width: 54ch;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0 0 2.5rem;
  }
  .hero-lead strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 4.5rem;
  }
  /* .cta-ghost is designed for dark Deep Reserve backgrounds (white outline) —
     override for the hero's porcelain background. */
  .hero-actions .cta-ghost {
    color: var(--color-brand-deep);
    border-color: color-mix(in srgb, var(--color-brand-deep) 35%, transparent);
  }
  .hero-actions .cta-ghost:hover {
    border-color: var(--color-brand-deep);
    background: color-mix(in srgb, var(--color-brand-deep) 8%, transparent);
    color: var(--color-brand-deep);
  }

  .hero-proof {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    gap: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    margin: 0;
  }
  .hero-proof div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hero-proof dt {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-proof dd {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin: 0;
  }

  @media (max-width: 720px) {
    .hero { padding: 5rem 0 4rem; }
    .hero-proof {
      grid-template-columns: repeat(2, max-content);
      gap: 1.5rem 3rem;
    }
  }

  /* ══════════════════════════════════════
     PRECISION STRIP
     ══════════════════════════════════════ */
  .precision-strip {
    background: var(--color-silk);
    border-bottom: 1px solid var(--color-line);
  }
  .precision-strip .wrap {
    padding-top: 0;
    padding-bottom: 0;
  }
  .strip-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-line);
  }
  .strip-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem 2rem;
    border-right: 1px solid var(--color-line);
  }
  .strip-label {
    font-family: var(--font-accent);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brand-warmth);
  }
  .strip-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  @media (max-width: 768px) {
    .strip-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .strip-list { grid-template-columns: 1fr; }
  }

  /* ══════════════════════════════════════
     PROGRAMS
     ══════════════════════════════════════ */
  .programs-section {
    background: var(--color-surface);
    padding: 6rem 0;
  }
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .program-card {
    background: var(--color-paper);
    padding: 1.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    transition: background 140ms ease;
  }
  .program-card:hover { background: var(--color-silk); }
  .program-tier {
    font-family: var(--font-accent);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brand-warmth);
  }
  .program-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand-deep);
    margin: 0;
    line-height: 1.2;
  }
  .program-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    flex: 1;
  }
  .program-link {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brand-deep);
    margin-top: 0.25rem;
  }
  .tier4-note {
    color: var(--color-mid);
    font-size: var(--text-meta);
  }
  .tier4-note a {
    color: var(--color-ink-soft);
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .programs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .programs-grid { grid-template-columns: 1fr; }
    .programs-section { padding: 4rem 0; }
  }

  /* ══════════════════════════════════════
     CHANNELS
     ══════════════════════════════════════ */
  .channels-section {
    background: var(--color-silk);
    color: var(--color-ink);
    padding: 7rem 0;
    position: relative;
    overflow: hidden;
  }
  .channels-inner {
    position: relative;
    z-index: 1;
  }
  .channels-head {
    text-align: center;
    margin: 0 auto 3.5rem;
  }
  .ch-eyebrow {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-warmth);
    margin: 0 0 1.25rem;
    display: block;
  }
  .channels-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .channels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .channel-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: background 150ms ease, border-color 150ms ease;
  }
  .channel-card:hover {
    background: var(--color-surface);
    border-color: var(--color-brand);
  }
  .channel-eyebrow {
    font-family: var(--font-accent);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brand-warmth);
    margin: 0;
  }
  .channel-card h3 {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--color-brand-deep);
    margin: 0;
    line-height: 1.2;
  }
  .channel-card p {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .channel-link {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-brand-bright);
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .channels-grid { grid-template-columns: 1fr; }
    .channels-section { padding: 5rem 0; }
  }

  /* ══════════════════════════════════════
     LOCATIONS
     ══════════════════════════════════════ */
  .locations-section {
    background: var(--color-surface);
    padding: 6rem 0;
  }
  .states-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .state-card {
    background: var(--color-paper);
    padding: 1.875rem 1.25rem;
    text-decoration: none;
    display: block;
    transition: background 140ms ease;
  }
  .state-card:hover { background: var(--color-surface); }
  .state-abbr {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.25rem;
    color: var(--color-brand-bright);
    line-height: 1;
    margin: 0 0 0.625rem;
  }
  .state-card h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-brand-deep);
    margin: 0 0 0.5rem;
  }
  .state-metros {
    font-size: 0.8125rem;
    color: var(--color-mid);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .states-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .states-grid { grid-template-columns: repeat(2, 1fr); }
    .locations-section { padding: 4rem 0; }
  }

  /* ══════════════════════════════════════
     FAQ
     ══════════════════════════════════════ */
  .faq-section {
    background: var(--color-silk);
    padding: 6rem 0;
  }
  .faq-section .section-head { max-width: 36ch; }

  @media (max-width: 560px) {
    .faq-section { padding: 4rem 0; }
    .wrap { padding: 0 1.25rem; }
  }
</style>
